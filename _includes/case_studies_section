<div class="py-24 bg-gradient-to-br from-indigo-50 via-white to-blue-50 relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-indigo-200 rounded-full opacity-10 blur-3xl"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-blue-200 rounded-full opacity-10 blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <h2 class="text-5xl font-extrabold bg-gradient-to-r from-indigo-600 to-blue-600 bg-clip-text text-transparent mb-4">{{ include.title }}</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-10">
        Real-world success stories showcasing our expertise in delivering innovative solutions
      </p>
      <a href="{{ '/casestudies/' | relative_url }}"
         class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-blue-700 hover:to-indigo-700 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        View All Case Studies
        <svg class="w-5 h-5 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>

    <!-- Case Studies Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
{% for case_study in site.portfolio %}
{% if case_study.featured %}
      <article class="group bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 border-2 border-gray-100 hover:border-blue-300 transform hover:-translate-y-2" itemscope itemtype="http://schema.org/Article">
        <!-- Image Section with Enhanced Presentation -->
        <div class="relative h-64 bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 overflow-hidden flex items-center justify-center p-8">
          <div class="relative z-10 w-full h-full flex items-center justify-center">
            <img src="{{ case_study.image_name | prepend: '/assets/images/casestudies/' | relative_url }}"
                 alt="{{ case_study.alt }}"
                 class="max-w-full max-h-full object-contain transform group-hover:scale-110 transition-transform duration-500 drop-shadow-2xl"
                 itemprop="image">
          </div>
          <!-- Featured Badge -->
          <div class="absolute top-5 right-5 z-20">
            <div class="bg-gradient-to-r from-yellow-400 to-orange-500 text-white px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wide shadow-lg flex items-center">
              <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              Featured
            </div>
          </div>
          <!-- Decorative gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        </div>

        <!-- Content Section -->
        <div class="p-8">
          <!-- Client & Title -->
          <div class="mb-6">
            <div class="flex items-center mb-3">
              <div class="w-2 h-2 bg-blue-600 rounded-full mr-2"></div>
              <span class="text-sm font-bold text-blue-600 uppercase tracking-wider">{{ case_study.client_name }}</span>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 leading-tight group-hover:text-blue-600 transition-colors duration-300" itemprop="headline">
              {{ case_study.title }}
            </h3>
          </div>

          <!-- Challenge Section -->
          <div class="mb-6">
            <div class="flex items-center mb-3">
              <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
              </div>
              <span class="text-sm font-bold text-gray-900 ml-3 uppercase tracking-wide">Challenge</span>
            </div>
            <p class="text-gray-700 leading-relaxed text-sm" itemprop="description">{{ case_study.challenge }}</p>
          </div>

          <!-- Solution Section -->
{% if case_study.solution %}
          <div class="mb-6">
            <div class="flex items-center mb-3">
              <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
              </div>
              <span class="text-sm font-bold text-gray-900 ml-3 uppercase tracking-wide">Solution</span>
            </div>
            <ul class="space-y-2">
{% for sol in case_study.solution limit:3 %}
              <li class="flex items-start text-sm text-gray-700">
                <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="flex-1">{{ sol }}</span>
              </li>
{% endfor %}
            </ul>
          </div>
{% endif %}

          <!-- Results/Impact Section -->
{% if case_study.results %}
          <div class="mb-6">
            <div class="flex items-center mb-3">
              <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
                </svg>
              </div>
              <span class="text-sm font-bold text-gray-900 ml-3 uppercase tracking-wide">Impact</span>
            </div>
            <ul class="space-y-2">
{% for point in case_study.results limit:3 %}
              <li class="flex items-start text-sm text-gray-700">
                <svg class="w-5 h-5 text-purple-500 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" clip-rule="evenodd"/>
                </svg>
                <span class="flex-1">{{ point }}</span>
              </li>
{% endfor %}
            </ul>
          </div>
{% endif %}

          <!-- Technology Tags -->
{% if case_study.technology %}
          <div class="mb-6 pt-6 border-t border-gray-200">
            <div class="flex items-center mb-3">
              <svg class="w-5 h-5 text-gray-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
              <span class="text-xs font-bold text-gray-600 uppercase tracking-wide">Technologies</span>
            </div>
            <div class="flex flex-wrap gap-2">
{% for tech in case_study.technology limit:4 %}
              <span class="inline-flex items-center px-3 py-1 bg-gradient-to-r from-blue-50 to-indigo-50 text-blue-700 text-xs font-semibold rounded-full border border-blue-200">
                {{ tech }}
              </span>
{% endfor %}
            </div>
          </div>
{% endif %}

          <!-- CTA Button -->
          <a href="{{ case_study.url }}"
             class="inline-flex items-center justify-center w-full px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-blue-700 hover:to-indigo-700 shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 group/btn">
            <span>Read Full Case Study</span>
            <svg class="w-5 h-5 ml-2 transform group-hover/btn:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </article>
{% endif %}
{% endfor %}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-16 text-center">
      <div class="inline-block bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl px-8 py-6 border-2 border-blue-200">
        <p class="text-gray-700 mb-4 text-lg font-medium">
          Want to see how we can transform your business?
        </p>
        <a href="{{ '/casestudies/' | relative_url }}"
           class="inline-flex items-center px-8 py-3 bg-white text-blue-600 font-bold rounded-xl hover:bg-blue-600 hover:text-white shadow-md hover:shadow-xl transition-all duration-300 border-2 border-blue-600">
          Explore All Success Stories
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
