<div class="py-20 bg-gradient-to-b from-gray-50 to-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex justify-between items-center mb-12">
      <h2 class="text-4xl font-bold text-gray-900">{{ include.title }}</h2>
      <a href="{{ '/casestudies/' | relative_url }}"
         class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 transition-colors duration-300">
        View All
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Case Studies Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for case_study in site.portfolio %}
      {% if case_study.featured %}
      <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 border border-gray-100 hover:border-blue-200">
        <!-- Image -->
        <div class="relative h-48 bg-gradient-to-br from-blue-50 to-purple-50 overflow-hidden flex items-center justify-center p-6">
          <img src="{{ case_study.image_name | prepend: '/assets/images/casestudies/' | relative_url }}"
               alt="{{ case_study.alt }}"
               class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300">
          <div class="absolute top-4 right-4 bg-white px-3 py-1 rounded-full text-xs font-semibold text-blue-600 shadow-sm">
            Featured
          </div>
        </div>

        <!-- Content -->
        <div class="p-6">
          <div class="mb-4">
            <span class="text-sm font-medium text-blue-600">{{ case_study.client_name }}</span>
            <h3 class="text-xl font-bold text-gray-900 mt-1 group-hover:text-blue-600 transition-colors">
              {{ case_study.title }}
            </h3>
          </div>

          <!-- Challenge -->
          <div class="mb-4">
            <div class="flex items-center mb-2">
              <svg class="w-5 h-5 text-red-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
              </svg>
              <span class="text-sm font-semibold text-gray-700">Challenge</span>
            </div>
            <p class="text-sm text-gray-600 line-clamp-3">{{ case_study.challenge }}</p>
          </div>

          <!-- Solution -->
          {% if case_study.solution %}
          <div class="mb-4">
            <div class="flex items-center mb-2">
              <svg class="w-5 h-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-sm font-semibold text-gray-700">Solution</span>
            </div>
            <ul class="space-y-1">
              {% for sol in case_study.solution limit:2 %}
              <li class="text-sm text-gray-600 flex items-start">
                <span class="text-green-500 mr-2">•</span>
                <span>{{ sol }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}

          <!-- Results -->
          {% if case_study.results %}
          <div class="mb-4">
            <div class="flex items-center mb-2">
              <svg class="w-5 h-5 text-purple-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
              </svg>
              <span class="text-sm font-semibold text-gray-700">Impact</span>
            </div>
            <ul class="space-y-1">
              {% for point in case_study.results limit:2 %}
              <li class="text-sm text-gray-600 flex items-start">
                <span class="text-purple-500 mr-2">•</span>
                <span>{{ point }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}

          <!-- CTA -->
          <a href="{{ case_study.url }}"
             class="inline-flex items-center text-blue-600 font-medium text-sm group-hover:text-blue-700 mt-4">
            Learn More
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
