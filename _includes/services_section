<div class="py-20 bg-gradient-to-b from-white to-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl font-bold text-center text-gray-900 mb-4">{{ include.title }}</h2>
    <p class="text-center text-gray-600 mb-16 max-w-2xl mx-auto">Empowering businesses with innovative solutions</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      {% assign number_of_services = 4 %}
      {% assign services = site.services | where: "category", "core" | sort: "score" | reverse %}
      {% assign sorted_services = services | sort: 'score' | reverse %}
      {% assign top_services = sorted_services | slice: 0, number_of_services %}

      {% for service in top_services %}
      <div class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-2xl transition-all duration-300 border border-gray-100 hover:border-purple-200 hover:-translate-y-2">
        <!-- Icon -->
        <div class="mb-6 flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-purple-600 p-2 transform group-hover:scale-110 transition-transform duration-300">
          <img src="{{ service.icon | prepend: '/assets/mascot/' | relative_url }}"
               alt="{{ service.title }}"
               class="max-w-full max-h-full object-contain">
        </div>

        <!-- Title -->
        <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-purple-600 transition-colors">
          {{ service.title }}
        </h3>

        <!-- Description -->
        <p class="text-gray-600 leading-relaxed mb-6">
          {{ service.description }}
        </p>

        <!-- Points list -->
        <ul class="space-y-3">
          {% for point in service.points %}
          <li class="flex items-start text-gray-700">
            <svg class="w-5 h-5 text-purple-500 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm">{{ point }}</span>
          </li>
          {% endfor %}
        </ul>

        <!-- Hover indicator -->
        <div class="mt-6 pt-6 border-t border-gray-100 opacity-0 group-hover:opacity-100 transition-opacity">
          <span class="text-purple-600 font-medium text-sm inline-flex items-center">
            Learn more
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>