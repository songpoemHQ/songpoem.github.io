<div class="py-24 bg-gradient-to-br from-blue-50 via-white to-purple-50 relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-purple-200 rounded-full opacity-10 blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-200 rounded-full opacity-10 blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="text-5xl font-extrabold text-center bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent mb-4">{{ include.title }}</h2>
    <p class="text-center text-gray-600 text-lg mb-20 max-w-2xl mx-auto">Empowering businesses with innovative solutions</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      {% assign number_of_services = 4 %}
      {% assign services = site.services | where: "category", "core" | sort: "score" | reverse %}
      {% assign sorted_services = services | sort: 'score' | reverse %}
      {% assign top_services = sorted_services | slice: 0, number_of_services %}

      {% for service in top_services %}
      <div class="group bg-white/80 backdrop-blur-sm rounded-3xl p-10 shadow-lg hover:shadow-2xl transition-all duration-500 border-2 border-gray-100 hover:border-purple-300 hover:-translate-y-3 relative overflow-hidden">
        <!-- Gradient overlay on hover -->
        <div class="absolute inset-0 bg-gradient-to-br from-purple-50/0 to-blue-50/0 group-hover:from-purple-50/50 group-hover:to-blue-50/50 transition-all duration-500 rounded-3xl"></div>

        <div class="relative z-10">
          <!-- Icon with gradient background -->
          <div class="mb-8 flex justify-center">
            <div class="w-24 h-24 bg-gradient-to-br from-purple-100 to-blue-100 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-md">
              <img src="{{ service.icon | prepend: '/assets/mascot/' | relative_url }}"
                   alt="{{ service.title }}"
                   class="w-16 h-16 object-contain">
            </div>
          </div>

          <!-- Title with gradient on hover -->
          <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:bg-gradient-to-r group-hover:from-purple-600 group-hover:to-blue-600 group-hover:bg-clip-text group-hover:text-transparent transition-all duration-300">
            {{ service.title }}
          </h3>

        <!-- Description -->
        <p class="text-gray-600 leading-relaxed mb-6">
          {{ service.description }}
        </p>

        <!-- Points list -->
        <ul class="space-y-3">
          {% for point in service.points %}
          <li class="flex items-start text-gray-700">
            <svg class="w-5 h-5 text-purple-500 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm">{{ point }}</span>
          </li>
          {% endfor %}
        </ul>

          <!-- Hover indicator -->
          <div class="mt-6 pt-6 border-t border-gray-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <span class="text-purple-600 font-semibold text-sm inline-flex items-center">
              Learn more
              <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
