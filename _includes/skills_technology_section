<div class="py-20 bg-gradient-to-b from-white to-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl font-bold text-center text-gray-900 mb-4">{{ include.title }}</h2>
    <p class="text-center text-gray-600 mb-16 max-w-2xl mx-auto">Modern technologies powering innovative solutions</p>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {% assign technologies = site.technologies | sort: "score" | reverse %}
      {% assign skills = technologies | slice: 0, 12 %}
      {% for skill in skills %}
      <div class="group relative" itemscope itemtype="http://schema.org/SoftwareApplication">
        <!-- Tech Badge -->
        <div class="bg-white rounded-lg p-4 border-2 border-gray-200 hover:border-purple-400 hover:shadow-lg transition-all duration-300 h-full flex items-center justify-center min-h-[80px]">
          <h3 class="text-xs sm:text-sm font-semibold text-gray-800 text-center group-hover:text-purple-600 transition-colors leading-tight" itemprop="name">
            {{ skill.title }}
          </h3>
        </div>

        <!-- Hover Effect Indicator -->
        <div class="absolute inset-0 rounded-lg bg-purple-500 opacity-0 group-hover:opacity-5 transition-opacity pointer-events-none"></div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
